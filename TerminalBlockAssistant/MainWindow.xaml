<ui:FluentWindow x:Class="TerminalBlockAssistant.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             xmlns:local="clr-namespace:TerminalBlockAssistant"
             xmlns:vms="clr-namespace:TerminalBlockAssistant.ViewModels"
             xmlns:views="clr-namespace:TerminalBlockAssistant.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 
    d:DesignHeight="300" d:DesignWidth="300">
    <ui:FluentWindow.Resources>
        <ResourceDictionary Source="/TerminalBlockAssistant;component/ResourceDictionaries/ApplicationTheme.xaml"/>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.Resources>
            <DataTemplate DataType="{x:Type vms:TerminalBlockViewModel}">
                <views:TerminalBlockAssistantView/>
            </DataTemplate>
        </Grid.Resources>
            <ContentControl Content="{Binding CurrentViewModel}"/>

        <ui:TitleBar>
            
        </ui:TitleBar>
    </Grid>
</ui:FluentWindow>
